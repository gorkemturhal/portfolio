---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HomeSidebar from '../components/HomeSidebar.astro';
import WorkCard from '../components/WorkCard.astro';
import Media from '../components/Media.astro';
import ClientLogos from '../components/ClientLogos.astro';
import BackToTop from '../components/BackToTop.astro';
import { MEDIA } from '../lib/media';
import { profile, howIWork, experience, about, shots } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title={`${profile.name} · ${profile.title}`} description={profile.bio} image="/og.jpg">
  <HomeSidebar />

  <main class="shell-main">
    <div class="shell-main-inner home">
      <section id="works" class="section" aria-labelledby="works-title">
        <header class="section-head" data-enter style="--i: 2">
          <h2 id="works-title" class="t-h4">Work</h2>
          <p class="t-body-2 t-muted text-pretty">
            Mobile and web products for consumers and businesses, across travel, fintech, e-commerce, sports and AI.
          </p>
        </header>
        <div class="grid grid-works">
          {projects.map((p, i) => <WorkCard project={p} priority={i < 2} />)}
        </div>
      </section>

      <ClientLogos class="mobile-only" headingId="clients-main" />

      <section id="shots" class="section" aria-labelledby="shots-title">
        <header class="section-head" data-reveal>
          <h2 id="shots-title" class="t-h4">Shots</h2>
          <p class="t-body-2 t-muted text-pretty">Single screens and interactions, in motion and still.</p>
        </header>
        <div class="grid">
          {
            shots.map((s) =>
              s.full ? (
                <Media item={s} {...MEDIA.full} fallbackAspect="5/4" forceAspect class="span-full" />
              ) : (
                <Media item={s} {...MEDIA.half} fallbackAspect="3/4" forceAspect />
              ),
            )
          }
        </div>
      </section>

      <section id="how-i-work" class="section" aria-labelledby="how-title">
        <header class="section-head">
          <h2 id="how-title" class="t-h4">How I work</h2>
          <p class="t-body-2 t-muted text-pretty">
            AI-native, end to end: AI takes on the repetitive work, so the decisions get my full attention.
          </p>
        </header>
        <ol class="steps">
          {
            howIWork.map((s) => (
              <li class="step">
                <div class="step-body">
                  <h3 class="step-title">
                    <Image src={s.icon} alt="" width={20} height={20} class="step-icon" />
                    {s.title}
                  </h3>
                  <p class="t-body-2 text-pretty step-text">{s.text}</p>
                  <p class="t-body-1 t-muted step-skills">{s.skills.join(' · ')}</p>
                </div>
                <ul class="step-tools" aria-label="Tools">
                  {s.tools.map((t) => (
                    <li class="tool">
                      <img src={t.src.src} alt="" width={t.width} height={t.height} loading="lazy" decoding="async" />
                      <span>{t.name}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="experience" class="section section-tight" aria-labelledby="experience-title">
        <header class="section-head" data-reveal>
          <h2 id="experience-title" class="t-h4">Experience</h2>
        </header>
        <ol class="exp">
          {
            experience.map((e) => (
              <li class="exp-row" data-reveal>
                <div class="exp-content">
                  <div class="exp-title">
                    <h3 class="exp-role">{e.role}</h3>
                    <p class="t-body-1 t-muted">{e.place}</p>
                  </div>
                  <p class="t-body-2 text-pretty exp-text">{e.text}</p>
                </div>
                <p class="t-body-1 exp-period">{e.period}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="about" class="section" aria-labelledby="about-title">
        <header class="section-head" data-reveal>
          <h2 id="about-title" class="t-h4">About</h2>
        </header>
        <div class="about-text" data-reveal>{about.map((para) => <p class="about text-pretty">{para}</p>)}</div>
      </section>
    </div>
  </main>

  <BackToTop />
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 80px;
    padding-bottom: 84px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    /* Navigasyondan atlayınca başlık ekranın tepesine yapışmasın. */
    scroll-margin-top: var(--pad);
  }
  .section-tight {
    gap: 24px;
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .grid-works {
    row-gap: 48px;
  }
  .grid :global(.span-full) {
    grid-column: 1 / -1;
  }

  /* How I work: kart değil, sıralı bir akış. */
  .steps {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 200px);
    gap: 48px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .step-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .step-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
  }
  .step-icon {
    width: 20px;
    height: 20px;
  }
  .step-text {
    max-width: 52ch;
  }
  .step-skills {
    max-width: 60ch;
  }
  .step-tools {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-self: start;
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-tertiary);
  }
  .tool img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  /* Experience */
  .exp-row {
    display: flex;
    gap: 64px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .exp-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .exp-title {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  /* Aynı seviyedeki öğe başlıkları How I work ile aynı ölçekte: başlık 18/500, açıklama 16, ikincil satırlar 14. */
  .exp-role {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
  }
  .exp-text {
    max-width: 60ch;
  }
  .exp-period {
    flex-shrink: 0;
    color: var(--text-date);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .about {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    max-width: 68ch;
  }

  @media (max-width: 1279px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .step-tools {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 20px;
    }
  }

  @media (max-width: 1023px) {
    .home {
      gap: 64px;
      padding-bottom: 0;
    }
  }

  @media (max-width: 639px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 24px 0;
    }
      .step-tools {
      grid-column: auto;
    }
    .grid-works {
      row-gap: 40px;
    }
    .exp-row {
      flex-direction: column-reverse;
      gap: 8px;
    }
    .exp-period {
      text-align: left;
    }
  }
</style>
