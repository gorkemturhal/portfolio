---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import BackToTop from '../../components/BackToTop.astro';
import NextProject from '../../components/NextProject.astro';
import { MEDIA } from '../../lib/media';
import { profile } from '../../data/site';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft && !data.soon);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;

// Bir sonraki proje: sıraya göre, kapağı olmayan yer tutucular ve "soon" projeler atlanır, sondan başa döner.
const ready = (await getCollection('projects', ({ data }) => !data.draft && !data.soon && Boolean(data.cover.image ?? data.cover.video)))
  .sort((a, b) => a.data.order - b.data.order);
const at = ready.findIndex((p) => p.id === project.id);
const next = ready.length > 1 ? ready[(at + 1) % ready.length] : undefined;

const ogSource = data.cover.image ?? data.cover.poster;
const og = ogSource ? await getImage({ src: ogSource, width: 1200, format: 'jpg', quality: 85 }) : undefined;
---

<Base title={`${data.title} · Görkem Turhal`} description={data.description} image={og?.src}>
  <aside class="shell-side detail-side">
    <div class="detail-top">
      <!-- Avatar, ana sayfadaki avatardan bu konuma kayarak geçer (transition:name). -->
      <a href="/" class="identity" data-enter style="--i: 0">
        <Image
          src={profile.avatar}
          alt=""
          width={32}
          height={32}
          densities={[1, 2, 3]}
          quality={90}
          class="identity-avatar"
          transition:name="identity-avatar"
        />
        <span class="identity-text">
          <span class="identity-name">{profile.name}</span>
          <span class="identity-title">{profile.title}</span>
        </span>
      </a>

      <a href="/" class="back" data-enter style="--i: 1">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M6.7 3.5 2.2 8l4.5 4.5M2.5 8h11.3"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Back to Home
      </a>
    </div>

    <div class="detail-head">
      <h1 class="t-h4 text-pretty" data-enter style="--i: 2">{data.title}</h1>
      <p class="t-body-2 text-pretty" data-enter style="--i: 2">{data.description}</p>
    </div>

    {
      data.meta.length > 0 && (
        <dl class="meta" data-enter style="--i: 3">
          {data.meta.map((m) => (
            <div class="meta-row">
              <dt class="t-muted">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="overview" data-enter style="--i: 4">
      <h2 class="t-caption t-muted">Overview</h2>
      <p class="t-body-1 text-pretty">{data.overview}</p>
    </div>
  </aside>

  <main class="shell-main">
    <div class="shell-main-inner gallery">
      {
        data.gallery.map((entry, i) =>
          'row' in entry ? (
            <div class="gallery-row" style={`--cols: ${entry.row.length}`}>
              {entry.row.map((item) => (
                <Media
                  item={item}
                  {...(entry.row.length === 3 ? MEDIA.third : MEDIA.half)}
                  fallbackAspect="3/4"
                  priority={i === 0}
                />
              ))}
            </div>
          ) : (
            <Media item={entry} {...MEDIA.full} fallbackAspect="5/4" priority={i === 0} />
          ),
        )
      }
    </div>
    {
      next && (
        <div class="shell-main-inner">
          <NextProject
            href={`/work/${next.id}`}
            title={next.data.cardTitle ?? next.data.title}
            thumb={next.data.cover.image ?? next.data.cover.poster}
          />
        </div>
      )
    }
  </main>

  <BackToTop />
</Base>

<style>
  .detail-side {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .detail-top {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }

  /* Paylaşılan bir proje linkinde de işi kimin yaptığı görünür. */
  .identity {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border-radius: 8px;
  }
  .identity-avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
  }
  .identity-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .identity-name {
    font-size: 14px;
    font-weight: 500;
  }
  .identity-title {
    font-size: 13px;
    color: var(--text-tertiary);
  }

  .detail-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    min-height: 32px;
    margin: -6px 0;
    font-size: 14px;
    color: var(--text-tertiary);
    transition: color 150ms ease;
  }
  .back svg {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      color: var(--text-primary);
    }
    .back:hover svg {
      transform: translateX(-3px);
    }
  }

  .meta {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .meta-row dt {
    flex-shrink: 0;
  }
  .meta-row dd {
    flex: 1;
    margin: 0;
    text-align: right;
    font-weight: 500;
  }

  .overview {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .gallery-row {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 1023px) {
    .detail-side {
      gap: 24px;
    }
    .detail-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    /* Mobilde künye kompakt: ilk görsel ekrana daha erken girsin. */
    .meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 16px;
    }
    .meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 0;
      border: 0;
    }
    .meta-row dd {
      text-align: left;
    }
    .gallery {
      gap: 16px;
    }
    .gallery-row {
      gap: 16px;
    }
  }
  @media (max-width: 639px) {
    .gallery-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
