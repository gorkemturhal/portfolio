---
interface Props {
  size?: 'small' | 'big';
}
const { size = 'small' } = Astro.props;
---

<span class:list={['tag', `tag-${size}`]}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    border-radius: 100px;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }
  .tag-small {
    padding: 4px 8px;
    font-size: 12px;
    color: var(--text-muted);
    background: var(--surface-subtle);
  }
  .tag-big {
    padding: 8px 16px;
    font-size: 14px;
    color: var(--text-primary);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
  }
</style>
