---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import Tag from './Tag.astro';
import { MEDIA } from '../lib/media';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { data } = project;
// "Soon" projeler: kart görünür ama link değildir (detay sayfası henüz yok).
const Tag_ = data.soon ? 'div' : 'a';
const linkProps = data.soon ? {} : { href: `/work/${project.id}`, 'data-astro-prefetch': '' };
---

<Tag_ {...linkProps} class:list={['work-card', { 'is-soon': data.soon }]} data-reveal>
  <div class="work-cover">
    <Media
      item={data.cover}
      {...MEDIA.half}
      fallbackAspect="5/4"
      forceAspect
      priority={priority}
      controls={false}
      reveal={false}
    />
  </div>
  <div class="work-text">
    <h3 class="t-h6 work-title">
      {data.cardTitle ?? data.title}
      {data.soon && <span class="work-soon">Soon</span>}
      {!data.soon && <svg class="work-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M4 10 10 4M5 4h5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>}
    </h3>
    <p class="t-body-1 t-muted text-pretty">{data.summary}</p>
  </div>
  {
    data.tags.length > 0 && (
      <ul class="work-tags">
        {data.tags.map((t) => (
          <li>
            <Tag>{t}</Tag>
          </li>
        ))}
      </ul>
    )
  }
</Tag_>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    /* Basınca hafifçe çöker: arayüz "duydum" der. */
    transition: transform 160ms var(--ease-out);
  }
  .work-card:not(.is-soon):active {
    transform: scale(0.985);
  }
  .work-card.is-soon {
    cursor: default;
  }

  .work-soon {
    padding: 2px 8px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-muted);
    background: var(--surface-subtle);
  }

  .work-cover {
    border-radius: var(--radius-media);
    overflow: hidden;
    transform: translateZ(0);
  }
  .work-cover :global(.media) {
    transition: transform 600ms var(--ease-out);
  }

  .work-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .work-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .work-arrow {
    color: var(--text-tertiary);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Hover yalnızca gerçek imleçte; dokunmatikte tap'te takılı kalmasın. */
  @media (hover: hover) and (pointer: fine) {
    .work-card:not(.is-soon):hover .work-cover :global(.media) {
      transform: scale(1.02);
    }
    .work-card:hover .work-arrow {
      opacity: 1;
      transform: translate(0, 0);
    }
  }

  .work-card:focus-visible {
    outline-offset: 6px;
    border-radius: calc(var(--radius-media) + 4px);
  }
  .work-card:focus-visible .work-arrow {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card:hover .work-cover :global(.media) {
      transform: none;
    }
  }
</style>
