---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const ease = 'cubic-bezier(0.23, 1, 0.32, 1)';
// Çıkış girişten hızlı: sistem yanıt veriyor, kullanıcı beklemiyor.
const page = {
  old: { name: 'page-out', duration: '140ms', easing: ease, fillMode: 'both' },
  new: { name: 'page-in', duration: '360ms', delay: '60ms', easing: ease, fillMode: 'both' },
};
const pageTransition = { forwards: page, backwards: page };
---

<!doctype html>
<html lang="en" class="first-load">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <!-- JS varsa animasyonlu durumlar devreye girer; yoksa içerik hep görünür. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body id="top">
    <div class="shell" transition:animate={pageTransition}>
      <slot />
    </div>
    <!-- İlk ekran JS modülünü beklemesin: görünür alandaki öğeler ilk boyamadan önce işaretlenir,
         girişleri CSS ile oynar. Sayfa geçişlerinde (first-load yok) çalışmaz. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains('first-load')) return;
        var h = window.innerHeight, i = 0;
        document.querySelectorAll('[data-reveal]').forEach(function (el) {
          var r = el.getBoundingClientRect();
          if (r.top < h && r.bottom > 0) {
            el.classList.add('is-visible', 'in-first-view');
            el.style.setProperty('--ri', i++);
          }
        });
      })();
    </script>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
